FROM docker.io/library/golang:1.27 AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . ./
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/events-hub ./cmd/server

FROM gcr.io/distroless/static-debian13

WORKDIR /app

COPY --from=builder /app/events-hub .

EXPOSE 8085

ENTRYPOINT ["/app/events-hub"]
