# -------------------------------------------------------------------
# Stage 1: Build the Vite SPA frontend
# -------------------------------------------------------------------
FROM docker.io/library/node:24-alpine AS frontend
WORKDIR /workspace/apps/web-client
RUN corepack enable

COPY apps/web-client/package.json apps/web-client/yarn.lock apps/web-client/.yarnrc.yml ./
RUN yarn install --immutable

COPY apps/web-client/ .
RUN yarn build

# -------------------------------------------------------------------
# Stage 2: Gateway PHP Runtime
# -------------------------------------------------------------------
FROM docker.io/library/php:8.5-zts

RUN apt-get update && apt-get install -y \
    unzip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/mlocati/php-extension-installer:latest /usr/bin/install-php-extensions /usr/local/bin/

RUN install-php-extensions \
    bcmath \
    intl \
    opcache \
    pcntl \
    pdo_pgsql \
    redis \
    swoole \
    zip

COPY --from=ghcr.io/extphprs/grpc-php-rs:latest-php8.5-zts /usr/local/ /usr/local/

COPY --from=docker.io/library/composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

COPY apps/gateway/ .
COPY --from=frontend /workspace/apps/gateway/public/dist/ /app/public/dist/

VOLUME /app/storage/logs

RUN composer dump-autoload --optimize && php artisan optimize:clear

EXPOSE 8000

ENTRYPOINT ["./entrypoint.sh"]
