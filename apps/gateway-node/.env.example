NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=*
MIDDLEWARE_REQUEST_DURATION=false

# Shared JWT signing secret (supports Laravel-style "base64:..." prefix)
APP_KEY=

# PostgreSQL (set DATABASE_URL or individual DB_* fields)
# DATABASE_URL=postgresql://realworld:secret@127.0.0.1:5432/realworld
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=realworld
DB_USERNAME=realworld
DB_PASSWORD=secret

# Upstream gRPC services
ARTICLE_SERVICE_TARGET=127.0.0.1:9092
FEED_AGGREGATOR_TARGET=127.0.0.1:9091
SOCIAL_GRAPH_TARGET=127.0.0.1:9090

# RabbitMQ event publisher
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=user
RABBITMQ_PASSWORD=secret
RABBITMQ_VHOST=rwa
RABBITMQ_EXCHANGE=events
