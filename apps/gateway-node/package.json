  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "oxfmt src/ test/",
    "format:check": "oxfmt --check src/ test/",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "typecheck": "tsc --noEmit",
